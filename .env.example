# Gloxad API (auth, profile, uploads, categories, courses, tutor, admin, ...). /api/* is proxied here.
# API reference: https://gloxard-backend.onrender.com
BACKEND_URL=https://gloxard-backend.onrender.com

# Used by socket.io (real-time messaging) which connects to the backend directly
NEXT_PUBLIC_BACKEND_URL=https://gloxard-backend.onrender.com

# Students must verify their email before reaching the dashboard (tutors always must).
# Set to "false" if the auth API doesn't send verification codes to students.
NEXT_PUBLIC_REQUIRE_STUDENT_EMAIL_VERIFICATION=true

# Optional: bypass the proxy and call the API directly (needs CORS on that API)
# NEXT_PUBLIC_API_URL=https://gloxard-backend.onrender.com/api
