# Authentication API (signup, signin, verify email, password reset). /api/auth/* is proxied here.
AUTH_BACKEND_URL=https://gloxard-backend.onrender.com

# ng_backend base URL for everything else (courses, notifications, tutor, ...). /api/* is proxied here.
BACKEND_URL=http://localhost:3001

# Used by socket.io (real-time messaging) which connects to the backend directly
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Students must verify their email before reaching the dashboard (tutors always must).
# Set to "false" if the auth API doesn't send verification codes to students.
NEXT_PUBLIC_REQUIRE_STUDENT_EMAIL_VERIFICATION=true

# Optional: bypass the proxy and call one API directly (needs CORS on that API)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
